---
import Layout from "@layouts/Layout.astro";
import BlogPost from "@components/BlogPost.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import RelatedFaqs from "@components/RelatedFaqs.astro";
import SocialShare from "@components/SocialShare.astro";
import FaqSearch from "@components/FaqSearch.astro";
import FaqPreviewHydrator from "@components/FaqPreviewHydrator.astro";
import { getAllFaqs, type Faq } from "@libs/microcms";

interface Props {
  faq: Faq;
}

export async function getStaticPaths() {
  const faqs = await getAllFaqs();
  return faqs.map((faq) => ({
    params: { id: faq.id },
    props: { faq },
  }));
}

const { faq } = Astro.props;
const categories = faq.category ?? [];
const tags = faq.tags ?? [];

const allFaqs = await getAllFaqs();

const titleText = faq.question || faq.title || "FAQ詳細";
const siteUrl = Astro.site ?? new URL("https://example.com");
const faqUrl = new URL(`/faq/${faq.id}/`, siteUrl).toString();
const breadcrumbItems = [
  { label: "FAQトップ", href: new URL("/", siteUrl).toString() },
  { label: titleText },
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      mainEntity: {
        "@type": "Question",
        name: titleText,
        acceptedAnswer: {
          "@type": "Answer",
          text: [faq.answer, faq.content].filter(Boolean).join(" ").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim(),
        },
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.label,
        item: item.href || faqUrl,
      })),
    },
  ],
};
---

<Layout title={titleText} description={faq.description || `${titleText} よくある質問の回答です。`} image={faq.thumbnail?.url} ogType="article" structuredData={structuredData}>
  <main data-faq-detail-page class="mx-auto w-full max-w-5xl">
    <div data-preview-loading hidden class="mb-5 rounded-lg border border-yellow-300 bg-yellow-100 px-4 py-3 font-medium text-yellow-900" role="status">下書きを読み込んでいます…</div>
    <div data-preview-error hidden class="mb-5 rounded-lg border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
      <article class="prose max-w-none">
        <h1 class="mb-3 text-3xl font-medium leading-normal">Page Not Found</h1>
        <p>お探しのページが見つかりませんでした。</p>
      </article>
    </div>
    <Breadcrumb items={breadcrumbItems} />
    <BlogPost faq={faq} />
    {(categories.length || tags.length) > 0 && <section class="mt-6 space-y-4 border-t border-slate-200 pt-5" aria-label="カテゴリとタグ">
      {categories.length > 0 && <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
        <h2 class="w-16 shrink-0 pt-1 text-sm font-semibold text-slate-600">カテゴリ</h2>
        <ul class="flex flex-wrap gap-2">
          {categories.map((category) => <li><a href={`/category/${category.id}/`} class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 transition hover:bg-blue-100 hover:text-blue-800">{category.name}</a></li>)}
        </ul>
      </div>}
      {tags.length > 0 && <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
        <h2 class="w-16 shrink-0 pt-1 text-sm font-semibold text-slate-600">タグ</h2>
        <ul class="flex flex-wrap gap-2">
          {tags.map((tag) => <li><a href={`/search/?tag=${encodeURIComponent(tag.id)}`} class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 transition hover:bg-blue-100 hover:text-blue-800">#{tag.name}</a></li>)}
        </ul>
      </div>}
    </section>}
    <SocialShare title={titleText} url={faqUrl} />
    <RelatedFaqs current={faq} faqs={allFaqs} />
    <section class="mt-10 rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200 sm:p-7" aria-label="FAQを再検索">
      <FaqSearch title="他のキーワードで検索する" description="お探しの疑問が見つからない場合は、キーワードを変えて検索をお試しください。" />
    </section>
  </main>
</Layout>
<FaqPreviewHydrator />
<script define:vars={{ faqId: faq.id }}>
  const key = "faq-views";
  const views = JSON.parse(localStorage.getItem(key) || "{}");
  views[faqId] = (views[faqId] || 0) + 1;
  localStorage.setItem(key, JSON.stringify(views));
</script>
