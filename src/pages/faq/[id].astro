---
import Layout from "@layouts/Layout.astro";
import BlogPost from "@components/BlogPost.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import RelatedFaqs from "@components/RelatedFaqs.astro";
import SocialShare from "@components/SocialShare.astro";
import FaqSearch from "@components/FaqSearch.astro";
import FaqPreviewHydrator from "@components/FaqPreviewHydrator.astro";
import { getAllFaqs, type Faq } from "@libs/microcms";
import { sanitizeAnswerHtml } from "@utils/sanitizeAnswerHtml";
import { formatDateJst } from "@utils/formatDateJst";

interface Props {
  faq: Faq;
}

export async function getStaticPaths() {
  const faqs = await getAllFaqs();
  return faqs.map((faq) => ({
    params: { id: faq.id },
    props: { faq },
  }));
}

const { faq } = Astro.props;
const categories = faq.category ?? [];
const tags = faq.tags ?? [];

const allFaqs = await getAllFaqs();

const titleText = faq.question || faq.title || "FAQ詳細";
const siteUrl = Astro.site ?? new URL("https://faq.monaka496.com/");
const siteHomeUrl = new URL("/", siteUrl).toString();
const faqUrl = new URL(`/faq/${faq.id}/`, siteUrl).toString();
const datePublished = faq.publishedAt ? new Date(faq.publishedAt) : undefined;
const dateModified = faq.updatedAt || faq.publishedAt;
const toIsoDate = (date?: Date) => (date && Number.isFinite(date.getTime()) ? date.toISOString() : undefined);
const publishedAt = toIsoDate(datePublished);
const modifiedAt = dateModified ? toIsoDate(new Date(dateModified)) : undefined;
const category = categories[0];
const breadcrumbItems = [
  { label: "FAQトップ", href: "/" },
  { label: titleText },
];
const breadcrumbListItems = [
  { name: "スマホのFAQ", item: siteHomeUrl },
  ...(category
    ? [{ name: category.name, item: new URL(`/category/${category.id}/`, siteUrl).toString() }]
    : []),
  { name: titleText, item: faqUrl },
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl.origin}/#website`,
      url: siteHomeUrl,
      name: "スマホのFAQ",
      inLanguage: "ja",
    },
    {
      "@type": "WebPage",
      "@id": `${faqUrl}#webpage`,
      url: faqUrl,
      name: `${titleText} | スマホのFAQ`,
      inLanguage: "ja",
      datePublished: publishedAt,
      dateModified: modifiedAt,
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: new URL(`/og/${faq.id}.png`, siteUrl).toString(),
      },
      isPartOf: { "@id": `${siteUrl.origin}/#website` },
      breadcrumb: { "@id": `${faqUrl}#breadcrumb` },
    },
    {
      "@type": "FAQPage",
      "@id": `${faqUrl}#faqpage`,
      isPartOf: { "@id": `${siteUrl.origin}/#website` },
      datePublished: publishedAt,
      dateModified: modifiedAt,
      mainEntity: [{
        "@type": "Question",
        name: titleText,
        acceptedAnswer: {
          "@type": "Answer",
          text: sanitizeAnswerHtml(faq.answer),
        },
      }],
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${faqUrl}#breadcrumb`,
      itemListElement: breadcrumbListItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: item.item,
      })),
    },
  ],
};
---

<Layout title={titleText} description={faq.description || `${titleText} よくある質問の回答です。`} ogImage={`/og/${faq.id}.png`} ogType="article" structuredData={structuredData}>
  <main data-faq-detail-page class="mx-auto w-full max-w-5xl">
    <div data-preview-loading hidden class="mb-5 rounded-lg border border-yellow-300 bg-yellow-100 px-4 py-3 font-medium text-yellow-900" role="status">下書きを読み込んでいます…</div>
    <div data-preview-error hidden class="mb-5 rounded-lg border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
      <article class="prose max-w-none">
        <h1 class="mb-3 text-3xl font-medium leading-normal">Page Not Found</h1>
        <p>お探しのページが見つかりませんでした。</p>
      </article>
    </div>
    <Breadcrumb items={breadcrumbItems} />
    <BlogPost faq={faq} />
    {(categories.length > 0 || tags.length > 0 || faq.publishedAt || faq.updatedAt) && <section class="mt-6 space-y-4 border-t border-slate-200 pt-5" aria-label="記事のメタ情報">
      {categories.length > 0 && <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
        <h2 class="w-16 shrink-0 pt-1 text-sm font-semibold text-slate-600">カテゴリ</h2>
        <ul class="flex flex-wrap gap-2">
          {categories.map((category) => <li><a href={`/category/${category.id}/`} class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 transition hover:bg-blue-100 hover:text-blue-800">{category.name}</a></li>)}
        </ul>
      </div>}
      {tags.length > 0 && <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
        <h2 class="w-16 shrink-0 pt-1 text-sm font-semibold text-slate-600">タグ</h2>
        <ul class="flex flex-wrap gap-2">
          {tags.map((tag) => <li><a href={`/search/?tag=${encodeURIComponent(tag.id)}`} class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 transition hover:bg-blue-100 hover:text-blue-800">#{tag.name}</a></li>)}
        </ul>
      </div>}
      {(faq.publishedAt || faq.updatedAt) && <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
        <h2 class="w-16 shrink-0 pt-1 text-sm font-semibold text-slate-600">日付</h2>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 pt-1 text-sm text-slate-600">
          {faq.publishedAt && <span>公開: <time datetime={faq.publishedAt}>{formatDateJst(faq.publishedAt)}</time></span>}
          {faq.updatedAt && <span>更新: <time datetime={faq.updatedAt}>{formatDateJst(faq.updatedAt)}</time></span>}
        </div>
      </div>}
    </section>}
    <SocialShare title={titleText} url={faqUrl} />
    <RelatedFaqs current={faq} faqs={allFaqs} />
    <section class="mt-10 rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200 sm:p-7" aria-label="FAQを再検索">
      <FaqSearch title="他のキーワードで検索する" description="お探しの疑問が見つからない場合は、キーワードを変えて検索をお試しください。" />
    </section>
  </main>
</Layout>
<FaqPreviewHydrator />
