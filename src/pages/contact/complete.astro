---
import Layout from "@layouts/Layout.astro";
---

<Layout title="お問い合わせ完了" description="お問い合わせを受け付けました。">
  <section class="mx-auto w-full max-w-3xl rounded-2xl border border-slate-200 bg-white px-6 py-10 text-center shadow-sm sm:px-10 sm:py-14" aria-labelledby="complete-title">
    <span class="mx-auto inline-flex size-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-7 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m5 12 4 4L19 6" />
      </svg>
    </span>
    <p class="mt-5 text-sm font-semibold tracking-wide text-blue-800">CONTACT</p>
    <h1 id="complete-title" class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">お問い合わせを受け付けました</h1>
    <p class="mt-4 leading-7 text-slate-600">お問い合わせいただきありがとうございます。<br class="hidden sm:block" />担当者より順次ご返信いたします。</p>
    <a href="/" class="mt-8 inline-flex items-center justify-center rounded-xl bg-blue-800 px-6 py-3 font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-blue-900 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">
      トップページへ戻る
    </a>
  </section>
</Layout>
