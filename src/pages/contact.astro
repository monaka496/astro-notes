---
import Layout from "@layouts/Layout.astro";
import { getSiteConfig } from "@libs/microcms";

const config = await getSiteConfig();
const formAction = config.SSGFormUrl || "https://ssgform.com/s/vuKUw0qp9B4w";
---

<Layout title="お問い合わせ" description="スマホのFAQへのお問い合わせフォームです。">
  <div class="mx-auto w-full max-w-3xl">
    <header class="mb-8">
      <p class="text-sm font-semibold tracking-wide text-blue-800">CONTACT</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">お問い合わせ</h1>
      <p class="mt-3 leading-7 text-slate-600">ご質問やサイトに関するお問い合わせはこちらからお送りください。</p>
    </header>

    <form action={formAction} method="POST" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
      <div>
        <label for="contact-name" class="mb-2 block text-sm font-semibold text-slate-800">
          お名前 <span class="text-rose-600">必須</span>
        </label>
        <input
          id="contact-name"
          name="お名前"
          type="text"
          autocomplete="name"
          required
          class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200"
        />
      </div>

      <div>
        <label for="contact-email" class="mb-2 block text-sm font-semibold text-slate-800">
          メールアドレス <span class="text-rose-600">必須</span>
        </label>
        <input
          id="contact-email"
          name="メールアドレス"
          type="email"
          autocomplete="email"
          required
          class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200"
        />
      </div>

      <div>
        <label for="contact-category" class="mb-2 block text-sm font-semibold text-slate-800">お問い合わせ種別</label>
        <select
          id="contact-category"
          name="お問い合わせ種別"
          class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200"
        >
          <option value="">選択してください</option>
          <option value="設定・操作">設定・操作</option>
          <option value="料金・プラン">料金・プラン</option>
          <option value="乗り換え・契約">乗り換え・契約</option>
          <option value="その他">その他</option>
        </select>
      </div>

      <div>
        <label for="contact-message" class="mb-2 block text-sm font-semibold text-slate-800">
          お問い合わせ内容 <span class="text-rose-600">必須</span>
        </label>
        <textarea
          id="contact-message"
          name="お問い合わせ内容"
          rows="8"
          required
          class="w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 leading-7 text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200"
        ></textarea>
      </div>

      <div class="pt-1 text-center">
        <button
          type="submit"
          class="inline-flex min-w-44 items-center justify-center rounded-xl bg-blue-800 px-6 py-3 font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-blue-900 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
        >
          送信する
        </button>
      </div>
    </form>
  </div>
</Layout>
