---
import {
  microCMSRichEditorHandler,
  syntaxHighlightingByShikiTransformer,
  responsiveImageTransformer,
  codeBlockFileNameTransformer,
} from "microcms-rich-editor-handler";
import type { Blog, Faq } from "@libs/microcms";

interface Props {
  blog?: Blog;
  faq?: Faq;
  previewMode?: boolean;
}

const { blog, faq, previewMode = false } = Astro.props;
const data: Partial<Blog & Faq> = faq || blog || {};
const answerText = data.answer || "";
const rawContent = data.content || "";

const { html: bodyHtml } = rawContent
  ? await microCMSRichEditorHandler(rawContent, {
      transformers: [
        responsiveImageTransformer(),
        codeBlockFileNameTransformer({ attributes: { class: "fileName" } }),
        syntaxHighlightingByShikiTransformer({
          defaultHighlightOptions: { lang: "javascript", theme: "github-dark" },
        }),
      ],
    })
  : { html: "" };

const questionText = data.question || data.title || (previewMode ? "下書きプレビュー" : "無題の質問");
---

<article data-faq-detail data-faq-id={data.id} hidden={previewMode} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
  <h1 class="flex items-start gap-3 text-xl font-bold leading-relaxed tracking-tight text-slate-900 sm:text-2xl">
    <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-800 sm:size-10">Q.</span>
    <span data-faq-question>{questionText}</span>
  </h1>

  <section class="mt-7 sm:mt-8">
    <div data-faq-answer-row hidden={!answerText} class="flex items-start gap-3 text-base leading-relaxed text-slate-800 sm:text-lg">
      <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-sm font-bold text-emerald-800 sm:size-10">A.</span>
      <p data-faq-answer class="mb-4 min-w-0 flex-1 font-semibold leading-relaxed text-slate-800">{answerText}</p>
    </div>
    <div data-faq-body set:html={bodyHtml} class="entry-content prose prose-lg mt-0 max-w-none" />
  </section>
</article>
