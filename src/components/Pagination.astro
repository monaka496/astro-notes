---
// src/components/Pagination.astro
import { LIMIT } from "@constants/index.ts";

interface Props {
  totalCount: number;
  current?: number;
  basePath?: string;
  q?: string;
  category?: string;
}

const { totalCount, current = 1, basePath = "", q, category } = Astro.props;
const totalPages = Math.ceil(totalCount / LIMIT);

if (totalPages <= 1) {
  return;
}

const pages = Array.from({ length: totalPages }).map((_, i) => i + 1);

const getPageUrl = (page: number) => {
  let path;

  if (category) {
    path =
      page === 1 ? `/category/${category}` : `/category/${category}/p/${page}`;
  } else {
    path = page === 1 ? "/" : `${basePath}/p/${page}`;
  }

  return q ? `${path}?${new URLSearchParams({ q }).toString()}` : path;
};

const visiblePages = totalPages <= 7
  ? pages
  : [...new Set([1, current - 1, current, current + 1, totalPages])].filter((page) => page >= 1 && page <= totalPages).sort((a, b) => a - b);
---

<nav aria-label="ページネーション" class="py-6">
<ul class="flex flex-wrap items-center justify-center gap-2">
  {current > 1 && <li><a href={getPageUrl(current - 1)} rel="prev" class="rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">前へ</a></li>}
  {
    visiblePages.map((p, index) => (
      <>
      {index > 0 && p - visiblePages[index - 1] > 1 && <li aria-hidden="true" class="px-1 text-slate-400">…</li>}
      <li>
        {current !== p ? (
          <a
            href={getPageUrl(p)}
            class="inline-flex min-w-10 justify-center rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-blue-800"
          >
            {p}
          </a>
        ) : (
          <span class="inline-flex min-w-10 justify-center rounded-md bg-blue-800 px-3 py-2 text-sm font-bold text-white" aria-current="page">
            {p}
          </span>
        )}
      </li>
      </>
    ))
  }
</ul>
</nav>
