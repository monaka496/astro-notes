---
import type { Faq } from "@libs/microcms";

interface Props {
  blogs: Faq[];
}

const { blogs } = Astro.props;
---

<div class="grid gap-3 sm:gap-4">
  {
    blogs.map((faq) => {
      const displayTitle = faq.question || faq.title || "無題の質問";
      const answer = faq.answer || "";
      return (
        <a href={`/faq/${faq.id}/`} class="group block rounded-xl border border-slate-200 bg-white p-4 text-inherit no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 sm:p-5">
          <article>
            <h2 class="flex items-start gap-3 text-base font-bold leading-7 text-slate-900 group-hover:text-blue-800 sm:text-lg">
              <img src="/icons/qa/q-icon.svg" alt="" aria-hidden="true" width="40" height="40" class="size-10 shrink-0" />
              <span class="group-hover:underline">{displayTitle}</span>
            </h2>
            <div class="mt-3 flex items-start gap-3 text-sm leading-7 text-slate-700 sm:mt-4 sm:text-base">
              <img src="/icons/qa/a-icon.svg" alt="" aria-hidden="true" width="40" height="40" class="size-10 shrink-0" />
              <p>{answer || "回答を確認する"}</p>
            </div>
          </article>
        </a>
      );
    })
  }
</div>
