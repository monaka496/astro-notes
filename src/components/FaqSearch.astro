<section aria-labelledby="faq-search-title">
  <h2 id="faq-search-title" class="text-base font-semibold text-slate-800">質問を検索</h2>
  <form action="/search" method="get" class="mt-3 flex gap-2 rounded-2xl bg-white p-2 shadow-sm ring-1 ring-slate-200 sm:p-3">
    <label class="min-w-0 flex-1">
      <span class="sr-only">キーワード</span>
      <input name="q" type="search" placeholder="検索ワードを入力（例：登録方法、支払い）" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-300" />
    </label>
    <button type="submit" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-blue-800 px-4 py-3 font-semibold text-white transition hover:bg-blue-900 sm:px-6">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="2" stroke-linecap="round"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 5 5" /></svg>
      <span>検索</span>
    </button>
  </form>
  <p class="mt-2 text-sm text-slate-500">質問・回答・カテゴリ・タグから検索できます。</p>
</section>
