<script>
  import { createClient } from "microcms-js-sdk";
  import type { Faq, FaqContentBlock } from "@libs/microcms";
  import { getFaqContentBlocks } from "@libs/faq-content";
  import { getCtaButtonColor } from "@libs/affiliate";

  const params = new URLSearchParams(window.location.search);
  const draftKey = params.get("draftKey");
  const previewRoot = document.querySelector<HTMLElement>("[data-preview-only]");
  const previewOnly = previewRoot !== null;
  const serviceDomain = previewRoot?.dataset.serviceDomain || "";
  const apiKey = previewRoot?.dataset.apiKey || "";
  const article = document.querySelector<HTMLElement>("[data-faq-detail]");
  const contentId = params.get("contentId") || article?.dataset.faqId;
  const loading = document.querySelector<HTMLElement>("[data-preview-loading]");
  const error = document.querySelector<HTMLElement>("[data-preview-error]");
  const detailPage = article?.closest<HTMLElement>("[data-faq-detail-page]");

  const escapeHtml = (value = "") => value.replace(/[&<>\"']/g, (char) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;",
  })[char]!);
  const safeLink = (value?: string) => {
    if (!value) return "";
    try {
      const url = new URL(value);
      return ["http:", "https:"].includes(url.protocol) ? url.toString() : "";
    } catch {
      return "";
    }
  };
  const renderContentBlock = (block: FaqContentBlock) => {
    if (block.fieldId === "richeditor") return `<div class="faq-rich-content">${block.richeditor || ""}</div>`;
    if (block.fieldId === "html") return `<div class="faq-custom-html">${block.html || ""}</div>`;
    if (block.fieldId === "affiliate_product") {
      const image = block.image?.url ? `<img src="${escapeHtml(block.image.url)}" alt="${escapeHtml(block.title)}" class="mx-auto max-h-56 w-full max-w-56 rounded-lg object-contain sm:mx-0" />` : "";
      const links = [["Amazon", block.amazon_url], ["楽天市場", block.rakuten_url], ["Yahoo!ショッピング", block.yahoo_url]]
        .map(([label, href]) => safeLink(href) ? `<a href="${escapeHtml(safeLink(href))}" target="_blank" rel="sponsored nofollow noopener noreferrer" class="inline-flex rounded-lg bg-amber-500 px-4 py-2 text-sm font-bold text-white no-underline">${label}</a>` : "")
        .join("");
      return `<section class="not-prose my-8 flex flex-col gap-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center">${image}<div class="min-w-0 flex-1">${block.title ? `<h2 class="mb-2 text-lg font-bold text-slate-900">${escapeHtml(block.title)}</h2>` : ""}${block.description ? `<p class="mb-4 whitespace-pre-wrap text-sm leading-relaxed text-slate-700">${escapeHtml(block.description)}</p>` : ""}<div class="flex flex-wrap gap-2">${links}</div></div></section>`;
    }
    if (block.fieldId === "affiliate_cta") {
      const href = safeLink(block.url);
      return `<div class="not-prose my-8 text-center">${block.micro_copy ? `<p class="mb-2 text-sm font-semibold text-slate-600">${escapeHtml(block.micro_copy)}</p>` : ""}${href ? `<a href="${escapeHtml(href)}" target="_blank" rel="sponsored nofollow noopener noreferrer" style="background-color:${getCtaButtonColor(block.style)}" class="inline-flex rounded-xl px-6 py-3 font-bold text-white no-underline shadow-sm transition hover:brightness-90">${escapeHtml(block.label || "詳しくはこちら")}</a>` : ""}${block.style?.length ? `<p class="mt-2 text-xs text-slate-500">${escapeHtml(block.style.join("・"))}</p>` : ""}</div>`;
    }
    if (block.fieldId === "affiliate_banner") {
      const href = safeLink(block.url);
      return href && block.banner_image?.url ? `<a href="${escapeHtml(href)}" target="_blank" rel="sponsored nofollow noopener noreferrer" class="not-prose my-8 block overflow-hidden rounded-xl no-underline"><img src="${escapeHtml(block.banner_image.url)}" alt="" class="h-auto w-full" /></a>` : "";
    }
    return "";
  };

  const activateInsertedScripts = (root: HTMLElement) => {
    root.querySelectorAll("script").forEach((original) => {
      const script = document.createElement("script");
      for (const attribute of original.attributes) script.setAttribute(attribute.name, attribute.value);
      script.textContent = original.textContent;
      original.replaceWith(script);
    });
  };

  const showMoshimoFallback = (root: HTMLElement) => {
    const scripts = [...root.querySelectorAll("script")];
    for (const script of scripts) {
      const source = script.textContent || "";
      const callStart = source.lastIndexOf("msmaflink(");
      if (callStart < 0) continue;
      const objectStart = source.indexOf("{", callStart);
      if (objectStart < 0) continue;

      let depth = 0;
      let inString = false;
      let escaped = false;
      let objectEnd = -1;
      for (let i = objectStart; i < source.length; i++) {
        const char = source[i];
        if (inString) {
          if (escaped) escaped = false;
          else if (char === "\\") escaped = true;
          else if (char === '"') inString = false;
          continue;
        }
        if (char === '"') inString = true;
        else if (char === "{") depth++;
        else if (char === "}" && --depth === 0) {
          objectEnd = i + 1;
          break;
        }
      }
      if (objectEnd < 0) continue;

      try {
        const item = JSON.parse(source.slice(objectStart, objectEnd)) as {
          eid?: string;
          n?: string;
          v?: string;
          d?: string;
          c_p?: string;
          p?: string[];
          u?: { u?: string; t?: string };
          b_l?: Array<{
            u_tx?: string;
            u_bc?: string;
            u_url?: string;
            a_id?: number;
            p_id?: number;
            pc_id?: number;
            pl_id?: number;
            s_n?: string;
            s_v?: string;
          }>;
        };
        if (!item.eid) continue;
        const placeholder = [...root.querySelectorAll<HTMLElement>("[id^='msmaflink-']")]
          .find((element) => element.id === `msmaflink-${item.eid}`);
        if (!placeholder || placeholder.textContent?.trim() !== "リンク") continue;

        const card = document.createElement("section");
        card.className = "my-6 flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-4 sm:flex-row sm:items-center";
        if (item.d && item.c_p && item.p?.[0]) {
          try {
            const image = document.createElement("img");
            image.src = new URL(`${item.c_p}${item.p[0]}`, item.d).toString();
            image.alt = item.n || "";
            image.className = "mx-auto max-h-48 w-full max-w-48 rounded-lg object-contain sm:mx-0";
            card.append(image);
          } catch {
            // Keep showing the preview card when an optional image URL is malformed.
          }
        }
        const details = document.createElement("div");
        details.className = "min-w-0 flex-1";
        const title = document.createElement("p");
        title.className = "mb-3 font-bold leading-relaxed text-slate-900";
        title.textContent = item.n || "商品リンク";
        details.append(title);
        const buttons = document.createElement("div");
        buttons.className = "flex flex-col gap-2 sm:flex-row";
        for (const button of item.b_l || []) {
          if (!button.u_url || !button.a_id || !button.p_id || !button.pc_id || !button.pl_id) continue;
          try {
            let destination = button.u_url;
            if (item.u?.t === button.s_n && item.u?.u) {
              destination = item.u.u;
            } else if (!(Number(item.v) >= 2.1 && button.s_n !== "yahoo")) {
              destination = encodeURI(decodeURI(destination));
            }
            const domainParts = window.location.hostname.split(".");
            const suffix = domainParts.pop();
            const service = domainParts.pop();
            const moshimoDomain = suffix === "msm" ? `${service}.msm` : "moshimo.com";
            let affiliateUrl = `https://af.${moshimoDomain}/af/c/click?a_id=${button.a_id}&p_id=${button.p_id}&pc_id=${button.pc_id}&pl_id=${button.pl_id}&url=${encodeURIComponent(destination)}`;
            if (button.s_v) affiliateUrl += `&s_v=${encodeURIComponent(button.s_v)}`;
            const link = document.createElement("a");
            link.href = affiliateUrl;
            link.target = "_blank";
            link.rel = "nofollow sponsored noopener noreferrer";
            link.referrerPolicy = "no-referrer-when-downgrade";
            link.textContent = button.u_tx || "商品を見る";
            link.className = "inline-flex w-full justify-center rounded-lg px-4 py-2 text-sm font-bold text-white no-underline sm:w-auto sm:flex-1";
            link.style.backgroundColor = button.u_bc && /^#[0-9a-f]{3,8}$/i.test(button.u_bc) ? button.u_bc : "#475569";
            buttons.append(link);
          } catch {
            // Ignore malformed tracking URLs in preview content.
          }
        }
        details.append(buttons);
        card.append(details);
        placeholder.replaceChildren(card);
      } catch (error) {
        console.warn("Could not render the Moshimo affiliate fallback.", error);
      }
    }
  };

  if (draftKey || previewOnly) {
    if (article) article.hidden = true;
    detailPage?.querySelectorAll<HTMLElement>(":scope > *").forEach((element) => {
      if (element !== article && element !== loading && element !== error) element.hidden = true;
    });
    if (loading) loading.hidden = false;

    if (!contentId || !draftKey || !serviceDomain || !apiKey) {
      if (loading) loading.hidden = true;
      if (error) error.hidden = false;
    } else {
      try {
        const client = createClient({ serviceDomain, apiKey });
        const faq = await client.getListDetail<Faq>({ endpoint: "faq", contentId, queries: { draftKey } });
        if (!faq) throw new Error("FAQ preview was not found.");

        const question = article?.querySelector<HTMLElement>("[data-faq-question]");
        const answerRow = article?.querySelector<HTMLElement>("[data-faq-answer-row]");
        const answer = article?.querySelector<HTMLElement>("[data-faq-answer]");
        const body = article?.querySelector<HTMLElement>("[data-faq-body]");
        const title = faq.question || faq.title || "無題の質問";

        if (question) question.textContent = title;
        if (answerRow) answerRow.hidden = !faq.answer;
        if (answer) answer.textContent = faq.answer || "";
        if (body) {
          body.innerHTML = getFaqContentBlocks(faq.content).map(renderContentBlock).join("");
          activateInsertedScripts(body);
          window.setTimeout(() => showMoshimoFallback(body), 2000);
        }
        if (article) article.hidden = false;
        if (loading) loading.hidden = true;
        document.title = `${title} | FAQプレビュー`;
      } catch (fetchError) {
        console.error("Failed to load FAQ preview:", fetchError);
        if (loading) loading.hidden = true;
        if (error) error.hidden = false;
      }
    }
  }

  if (!previewOnly && !draftKey && article) {
    const body = article.querySelector<HTMLElement>("[data-faq-body]");
    if (body) window.setTimeout(() => showMoshimoFallback(body), 2000);
  }
</script>
